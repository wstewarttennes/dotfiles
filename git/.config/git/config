[user]
	name = Weston Stewart-Tennes
	email = wstewarttennes@gmail.com

[init]
	defaultBranch = main

[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[fetch]
	prune = true
	pruneTags = true

[core]
	editor = nvim
	# global ignore lives alongside this file at ~/.config/git/ignore
	excludesfile = ~/.config/git/ignore

[color]
	ui = auto
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname

[diff]
	colorMoved = zebra
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true

[rebase]
	autosquash = true
	autostash = true

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	ci = commit
	cm = commit -m
	amend = commit --amend --no-edit
	unstage = reset HEAD --
	last = log -1 HEAD --stat
	lg = log --oneline --graph --decorate --all -30
	graph = log --graph --pretty=format:'%C(auto)%h%d %s %C(dim)(%cr) <%an>%Creset' --all
	undo = reset --soft HEAD~1
	aliases = config --get-regexp ^alias\\.
