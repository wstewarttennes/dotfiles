# ~/.ssh/config — safe defaults (NO private keys are tracked; those stay local).
# Machine-local / secret host entries go in ~/.ssh/config.local.
#
# Included FIRST so per-host settings there win (SSH uses first-obtained value).
Include ~/.ssh/config.local

Host *
	AddKeysToAgent yes
	UseKeychain yes
	ServerAliveInterval 60
	ServerAliveCountMax 3
	# Prefer an ed25519 key if present; ssh ignores this gracefully if missing.
	IdentityFile ~/.ssh/id_ed25519
